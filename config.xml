<?xml version='1.0' encoding='utf-8'?>
<widget id="com.diacare.app" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DiaCare</name>
    <description>DiaCare - a diabetes risk assessment and health guidance app for Bangladeshi patients</description>
    <author email="support@diacare.app" href="#">DiaCare Team</author>
    <content src="index.html" />
    <access origin="*" />
    <platform name="android" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="KeepRunning" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="33" />
</widget>
